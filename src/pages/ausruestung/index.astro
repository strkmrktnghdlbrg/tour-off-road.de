---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Announce from '../../components/Announce.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Pills from '../../components/Pills.astro';
import GearCard from '../../components/GearCard.astro';
import MagCard from '../../components/MagCard.astro';
import { gearAffiliateHref } from '../../products';

const gear = await getCollection('ausruestung');

// Ratgeber & Wissen: Magazin-Artikel aus dem Cluster "ausruestung".
const allMagazin = await getCollection('magazin');
const ausruestungRatgeber = allMagazin
  .filter((p) => p.data.cluster === 'ausruestung')
  .slice(0, 3)
  .map((p) => ({
    href: `/magazin/${p.data.slug}/`,
    hero: p.data.hero,
    category: p.data.category,
    title: p.data.title,
  }));

const categoryLabel: Record<string, string> = {
  recovery: 'Recovery',
  camping: 'Camping',
  navigation: 'Navigation',
  campkueche: 'Camp-Küche',
  reifen: 'Reifen',
};

// Demo-Kacheln aus dem Mockup (kommen via Content-Agent als echte Eintraege nach).
// demoGear entfernt (21.08.2026): die fuenf Produkte stehen als echte Eintraege
// in src/content/ausruestung und wurden hier mit erfundenen Noten und Preisen
// gedoppelt.

const pills = [
  { label: 'Alle', href: '/ausruestung/', on: true },
  { label: 'Recovery', href: '/ausruestung/recovery/' },
  { label: 'Camping', href: '/ausruestung/camping/' },
  { label: 'Navigation', href: '/ausruestung/navigation/' },
  { label: 'Camp-Küche', href: '/ausruestung/campkueche/' },
  { label: 'Reifen', href: '/ausruestung/reifen/' },
];
---

<Base
  title="Offroad-Ausrüstung im Überblick - tour-off-road.de"
  description="Ausrüstung für Sand, Schlamm, Fels und Furt: Bergen, Camping, Navigation, Reifen und Campküche - eingeordnet nach Einsatzzweck."
  path="/ausruestung/"
>
  <Announce />
  <Header active="ausruestung" />

  <Breadcrumb items={[{ label: 'Start', href: '/' }, { label: 'Ausrüstung' }]} />

  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">17 Ausrüstungs-Empfehlungen</p>
      <h1>Ausrüstung, nach Einsatzzweck sortiert.</h1>
      <p>
        Keine Listen-Affiliate-Abzocke. Jede Empfehlung kommt aus dem echten Einsatz -
        Sand, Schlamm, Fels, Furt. Was nicht hält, fliegt raus.
      </p>
    </div>
  </section>

  <div class="wrap">
    <Pills items={pills} />
  </div>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="route-grid">
        {
          gear.map((g) => (
            <GearCard
              href={gearAffiliateHref(g.data, `gear-${g.data.slug}`)}
              image={g.data.image}
              title={g.data.title}
              category={categoryLabel[g.data.category]}
              excerpt={g.data.excerpt}
              price={g.data.price}
              rating={g.data.rating}
              badge={g.data.badge}
            />
          ))
        }
      </div>
      <p class="muted" style="font-size:13px;text-align:center;margin-top:32px">
        Produktlinks sind Affiliate-Links. Du zahlst dadurch nicht mehr, wir bekommen eine kleine Provision. Preise nennen wir nur dort, wo wir sie beim Händler geprüft haben — sonst steht der Preis beim Händler.
      </p>
    </div>
  </section>

  {
    ausruestungRatgeber.length > 0 && (
      <section class="section tight">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">Ratgeber & Wissen</p>
              <h2>Mehr zur Ausrüstung</h2>
            </div>
          </div>
          <div class="mag-grid">
            {ausruestungRatgeber.map((r) => <MagCard {...r} />)}
          </div>
        </div>
      </section>
    )
  }

  <Footer />
</Base>
